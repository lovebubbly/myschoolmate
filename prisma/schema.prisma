generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Notice {
  id        Int      @id @default(autoincrement())
  title     String
  url       String   @unique
  date      String   // Keeping as String initially to avoid parsing issues during crawl, can parse later or in logic. Actually DateTime is better if we parse immediately. I'll stick to String for 'date' from website (e.g. "2025.12.24.") and 'crawledAt' as DateTime.
  category  String   // "Academic", "Scholarship", "General", "Employment"
  
  content   String?
  summary   String?
  
  // Filter Criteria (Extracted)
  minGrade  Int?
  maxIncome Int?     // e.g. 8 (meaning 0~8)
  minGpa    Float?
  scholarshipType String?
  
  deadline  String?
  
  processed Boolean  @default(false) // If processed by Gemini/AI
  isPinned  Boolean  @default(false) // If it's a pinned notice at the top
  
  
  // Tags (N:M)
  tags      NoticeTagOnNotice[]
  actions   NoticeAction[]
  favorites NoticeFavorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserProfile {
  id        Int      @id @default(autoincrement())
  identityKey String? @unique // e.g. "email:user@example.com" for social login identity
  email     String?
  displayName String?
  grade     Int      @default(1)
  cohortYear Int?
  income    Int      @default(10) // 0-10, 10=default/rich/unknown constraint? Let's say 10 is max.
  gpa       Float    @default(0.0)
  trackId   Int?
  notificationEmail String?
  emailAlertsEnabled Boolean @default(false)
  lastEmailedBriefingDate String?
  dashboardState String?
  track     Track?   @relation(fields: [trackId], references: [id])
  plannerProgresses PlannerProgress[]
  noticeActions NoticeAction[]
  noticePresets NoticePreset[]
  noticeFavorites NoticeFavorite[]
  pushSubscriptions PushSubscription[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Track {
  id          Int      @id @default(autoincrement())
  name        String   // "정보통신 및 네트워크", etc.
  courses     Course[]
  users       UserProfile[]
  plannerProgresses PlannerProgress[]
  requirements TrackCurriculumRequirement[]
}

model PlannerProgress {
  id        Int      @id @default(autoincrement())
  userId    Int
  trackId   Int
  courseId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     Track      @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId, courseId])
  @@index([userId, trackId])
}

model Course {
  id        String   @id // Course Number (e.g., 5108112)
  name      String
  credit    String   // e.g. "3-3-0"
  creditPoints Int    @default(0)
  grade     Int?     // Recommended Grade (1-4)
  semester  Int?     // 1 or 2
  category  String?  // "전공 필수", "전공 선택", "교양"
  tracks    Track[] 
}

model CurriculumVersion {
  id         Int      @id @default(autoincrement())
  academicYear Int     @unique
  label       String
  source      String?
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  requirements TrackCurriculumRequirement[]
}

model TrackCurriculumRequirement {
  id               Int       @id @default(autoincrement())
  curriculumVersionId Int
  trackId          Int
  requiredCourses  String
  categoryRequirements String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  curriculumVersion CurriculumVersion @relation(fields: [curriculumVersionId], references: [id], onDelete: Cascade)
  track            Track             @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([curriculumVersionId, trackId])
}

model NoticeTag {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notices   NoticeTagOnNotice[]
}

model NoticeTagOnNotice {
  noticeId Int
  tagId    Int
  createdAt DateTime @default(now())

  notice   Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  tag      NoticeTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noticeId, tagId])
  @@index([tagId])
  @@index([noticeId])
}

model NoticeAction {
  id        Int      @id @default(autoincrement())
  userId    Int
  noticeId  Int
  state     String   // todo | in_progress | done | dismissed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  notice Notice      @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@unique([userId, noticeId])
  @@index([userId, state])
  @@index([noticeId])
}

model NoticeFavorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  noticeId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  notice Notice      @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@unique([userId, noticeId])
  @@index([userId])
  @@index([noticeId])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId])
}

model NoticePreset {
  id               Int      @id @default(autoincrement())
  userId           Int
  name             String
  categories       String?
  tags             String?
  profileOverrides String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DailyBriefing {
  id        Int      @id @default(autoincrement())
  userId    Int
  content   String
  date      String   // YYYY-MM-DD to check uniqueness per day
  createdAt DateTime @default(now())
}




model CafeteriaMenu {
  id          Int      @id @default(autoincrement())
  restaurant  String   // "Hanbit", "Star", "Eunhasu"
  date        String   // "YYYY-MM-DD" or "MM.DD(Day)"
  mealType    String   // "BREAKFAST", "LUNCH", "DINNER"
  menuContent String   // Main menu items
  price       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([restaurant, date, mealType])
}
